{
 "version": 1,
 "description": "File classification rules for the inventory stage (WP1). Evaluation order: path_rules -> Mach-O role -> authoritative magic -> name_rules -> ext_categories -> fallback_magic -> generic_magic -> 'other'. Magic wins over the extension; weak magic (confidence < 0.6) never overrides.",
 "categories": [
  "executable",
  "framework",
  "plugin",
  "dylib",
  "assets_car",
  "ui_layout",
  "localization",
  "plist",
  "image",
  "audio",
  "video",
  "font",
  "database",
  "script",
  "shader",
  "model_3d",
  "engine_data",
  "assetbundle",
  "packed_archive",
  "signing",
  "config",
  "text",
  "other"
 ],
 "path_rules": [
  {
   "id": "signing.code_signature",
   "regex": "(^|/)_CodeSignature/",
   "category": "signing"
  },
  {
   "id": "signing.sc_info",
   "regex": "(^|/)SC_Info/",
   "category": "signing"
  },
  {
   "id": "signing.provision",
   "regex": "(^|/)embedded\\.mobileprovision$",
   "category": "signing"
  },
  {
   "id": "signing.itunes_metadata",
   "regex": "^iTunesMetadata\\.plist$",
   "category": "signing",
   "scope": "outside"
  },
  {
   "id": "signing.itunes_artwork",
   "regex": "^iTunesArtwork(@\\dx)?(\\.[A-Za-z0-9]+)?$",
   "category": "signing",
   "scope": "outside"
  },
  {
   "id": "assets.car",
   "regex": "(^|/)Assets\\.car$",
   "category": "assets_car"
  },
  {
   "id": "ui.compiled_dir",
   "regex": "(^|/)[^/]+\\.(storyboardc|nib)/",
   "category": "ui_layout"
  },
  {
   "id": "l10n.strings",
   "regex": "\\.lproj/[^/]+\\.(strings|stringsdict)$",
   "category": "localization"
  }
 ],
 "macho_rules": [
  {
   "id": "macho.dylib",
   "ext": ".dylib",
   "category": "dylib"
  },
  {
   "id": "macho.framework",
   "regex": "\\.framework/",
   "category": "framework"
  },
  {
   "id": "macho.plugin",
   "regex": "(^|/)(PlugIns|Watch|AppClips)/|\\.appex/",
   "category": "plugin"
  }
 ],
 "macho_default": "executable",
