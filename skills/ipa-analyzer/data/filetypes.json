 "name_rules": [
  {
   "id": "unity.global_metadata",
   "regex": "(^|/)global-metadata\\.dat$",
   "category": "engine_data"
  },
  {
   "id": "unity.serialized",
   "regex": "(^|/)(globalgamemanagers|mainData|level\\d+|unity default resources|unity_builtin_extra|boot\\.config|app\\.info)$",
   "category": "engine_data"
  },
  {
   "id": "unity.sharedassets",
   "regex": "(^|/)sharedassets\\d+\\.assets(\\.resS)?$",
   "category": "engine_data"
  },
  {
   "id": "doc.licence",
   "regex": "(^|/)(LICENSE|LICENCE|NOTICE|README|COPYING|AUTHORS)$",
   "category": "text"
  },
  {
   "id": "cfg.pkginfo",
   "regex": "(^|/)PkgInfo$",
   "category": "config"
  }
 ],
