    ],
    "hot_name_regex": [
      "(?i)hot[_.-]?(update|fix)",
      "(?i)^hotfix",
      "(?i)^hot[_.-]?update",
      "(?i)^logic$",
      "(?i)hotcode"
    ],
    "sources": [
      "HybridCLR documentation describes AOT supplemental metadata (mscorlib, System, System.Core, UnityEngine.*) vs hot-update assemblies; name lists are heuristics"
